```{=html}
<div class="quarto-listing-container-custom">
  <% for (const item of items) { %>
    <div class="project-item">
      
      <!-- 渲染图片 -->
      <% if (item.image) { %>
        <div class="project-image">
          <a href="<%= item.path %>">
            <img src="<%= item.image %>" alt="<%= item.title %>">
          </a>
        </div>
      <% } %>

      <!-- 渲染内容部分 -->
      <div class="project-content">
        <h4>
          <a href="<%= item.path %>"><%= item.short_title || item.title %></a>
        </h4>
        
        <div class="listing-meta-row gap-15">
          <div>
            <% if (item.categories && item.categories.includes('longterm')) { %>
              Started on <%= item.date %>
            <% } else if (item.categories && item.categories.includes('ongoing')) { %>
              Updated on <%= item.date %>
            <% } else if (item.categories && item.categories.includes('manuscript')) { %>
              Drafted on <%= item.date %>
            <% } else if (item.categories && item.categories.includes('publication')) { %>
              Published on <%= item.date %>
            <% } else { %>
              <%= item.date %>
            <% } %>
          </div>
          
          <!-- 渲染 DOI, GitHub, OSF 图标链接 -->
          <div class="icon-link-group">
            <% if (item.doi) { %>
              <a href="<%= item.doi %>" target="_blank" class="secondary-icon-link">
                <i class="ai ai-doi"></i> DOI
              </a>
            <% } %>
            <% if (item.github) { %>
              <a href="<%= item.github %>" target="_blank" class="secondary-icon-link">
                <i class="bi bi-github"></i> GitHub
              </a>
            <% } %>
            <% if (item.osf) { %>
              <a href="<%= item.osf %>" target="_blank" class="secondary-icon-link">
                <i class="ai ai-osf"></i> OSF
              </a>
            <% } %>
          </div>
        </div>

        <!-- Description 折叠条目 -->
        <% if (item.list_description || item.description) { %>
          <details class="custom-details" open>
            <summary>Description</summary>
            <div class="custom-details-content"><%= item.list_description || item.description %></div>
          </details>
        <% } %>

        <!-- Responsibilities 折叠条目 -->
        <% if (item.responsibilities) { %>
          <details class="custom-details">
            <summary>My Responsibilities</summary>
            <div class="custom-details-content"><%= item.responsibilities %></div>
          </details>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
```