```{=html}
<div class="quarto-listing-container-custom">
  <% for (const item of items) { %>
    <div class="project-item" style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid var(--bs-border-color);">
      
      <!-- 渲染图片 -->
      <% if (item.image) { %>
        <div class="project-image" style="flex: 0 0 250px;">
          <a href="<%= item.path %>">
            <img src="<%= item.image %>" alt="<%= item.title %>" style="width: 100%; border-radius: 5px; object-fit: cover;">
          </a>
        </div>
      <% } %>

      <!-- 渲染内容部分 -->
      <div class="project-content" style="flex: 1; min-width: 300px;">
        <h4 style="margin-top: 0; margin-bottom: 5px;">
          <a href="<%= item.path %>" style="text-decoration: none;"><%= item.short_title || item.title %></a>
        </h4>
        
        <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 15px; color: var(--bs-secondary-color); margin-bottom: 15px; font-size: 0.9em;">
          <div>
            <% if (item.categories && item.categories.includes('longterm')) { %>
              Started on <%= item.date %>
            <% } else if (item.categories && item.categories.includes('ongoing')) { %>
              Updated on <%= item.date %>
            <% } else if (item.categories && item.categories.includes('manuscript')) { %>
              Drafted on <%= item.date %>
            <% } else if (item.categories && item.categories.includes('publication')) { %>
              Published on <%= item.date %>
            <% } else { %>
              <%= item.date %>
            <% } %>
          </div>
          
          <!-- 渲染 DOI, GitHub, OSF 图标链接 -->
          <div style="display: flex; gap: 12px;">
            <% if (item.doi) { %>
              <a href="<%= item.doi %>" target="_blank" style="text-decoration: none; color: var(--bs-secondary-color); transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1">
                <i class="ai ai-doi"></i> DOI
              </a>
            <% } %>
            <% if (item.github) { %>
              <a href="<%= item.github %>" target="_blank" style="text-decoration: none; color: var(--bs-secondary-color); transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1">
                <i class="bi bi-github"></i> GitHub
              </a>
            <% } %>
            <% if (item.osf) { %>
              <a href="<%= item.osf %>" target="_blank" style="text-decoration: none; color: var(--bs-secondary-color); transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1">
                <i class="ai ai-osf"></i> OSF
              </a>
            <% } %>
          </div>
        </div>

        <!-- Description 折叠条目 -->
        <% if (item.list_description || item.description) { %>
          <details open style="margin-bottom: 10px;">
            <summary style="cursor: pointer; font-weight: 500; outline: none; color: var(--bs-body-color);">Description</summary>
            <div style="margin-top: 8px; color: var(--bs-body-color); font-size: 0.95em; opacity: 0.9;"><%= item.list_description || item.description %></div>
          </details>
        <% } %>

        <!-- Responsibilities 折叠条目 -->
        <% if (item.responsibilities) { %>
          <details>
            <summary style="cursor: pointer; font-weight: 500; outline: none; color: var(--bs-body-color);">My Responsibilities</summary>
            <div style="margin-top: 8px; color: var(--bs-body-color); font-size: 0.95em; opacity: 0.9;"><%= item.responsibilities %></div>
          </details>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
```