```{=html}
<div class="quarto-listing-container-custom">
  <% for (let i = 0; i < items.length; i++) { %>
    <% const item = items[i]; %>
    <% const isActiveItem = item.categories && item.categories.includes('active'); %>
    <% const isFirstActive = isActiveItem && i === 0; %>
    <% const isDevelopingItem = item.categories && item.categories.includes('developing'); %>
    <% const primaryHref = isDevelopingItem && item.github ? item.github : item.path; %>
    
    <% if (isFirstActive) { %>
    <div class="package-item pkg-item-layout pkg-item-layout-first">
    <% } else { %>
    <div class="package-item pkg-item-layout">
    <% } %>
      
      <!-- 渲染包的 Logo -->
      <% if (item.image) { %>
        <div class="package-logo">
          <a href="<%= primaryHref %>"<% if (isDevelopingItem && item.github) { %> target="_blank"<% } %>>
            <!-- object-fit: contain 保证 Logo 不会被裁切 -->
            <img src="<%= item.image %>" alt="<%= item.title %> logo">
          </a>
        </div>
      <% } %>

      <!-- 渲染内容部分 -->
      <div class="package-content">
        <h3>
          <a href="<%= primaryHref %>"<% if (isDevelopingItem && item.github) { %> target="_blank"<% } %>><%= item.title %></a>
          <% if (item.categories && item.categories.includes('archived')) { %>
            <span class="archived-badge">Archived</span>
          <% } %>
          <% if (isDevelopingItem) { %>
            <span class="archived-badge">Developing</span>
          <% } %>
        </h3>
        
        <!-- 包的相关链接 (如 CRAN, GitHub 等，你可以在 YAML 中配置这些字段) -->
        <div class="listing-meta-row gap-12">
          <% if (item.homepage) { %>
            <a href="<%= item.homepage %>" target="_blank" class="secondary-icon-link">
              <i class="bi bi-house-door"></i> Homepage
            </a>
          <% } %>
          <% if (item.cran) { %>
            <a href="<%= item.cran %>" target="_blank" class="secondary-icon-link">
              <i class="fa-brands fa-r-project"></i> CRAN
            </a>
          <% } %>
          <% if (item.github) { %>
            <a href="<%= item.github %>" target="_blank" class="secondary-icon-link">
              <i class="bi bi-github"></i> GitHub
            </a>
          <% } %>
          <% if (item.osf) { %>
            <a href="<%= item.osf %>" target="_blank" class="secondary-icon-link">
              <i class="ai ai-osf"></i> OSF
            </a>
          <% } %>
        <% if (item.pkg_doi) { %>
          <a href="<%= item.pkg_doi %>" target="_blank" class="secondary-icon-link">
              <i class="ai ai-doi"></i> DOI
            </a>
          <% } %>
        </div>

        <!-- 包的简介 (直接展示，不使用折叠) -->
        <% if (item.description) { %>
          <div class="listing-description">
            <%= item.description %>
          </div>
        <% } %>
      </div>
    </div>

    <% if (isFirstActive) { %>
      <div id="interactive-divider-active-placeholder"></div>
    <% } %>
  <% } %>
</div>
```
